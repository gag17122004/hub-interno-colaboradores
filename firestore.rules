rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Firestore Security Rules — Hub Interno Pratik
//
//  Caminhos válidos (4 segmentos cada):
//    compartilhado/{key}/dados/value    → dados globais compartilhados
//    usuarios/{userName}/dados/{key}    → dados pessoais por usuário
//
//  FASE ATUAL: autenticação customizada via localStorage (sem Firebase Auth).
//  As regras aceitam requisições da origem do app em produção.
//
//  TODO — após migrar para Firebase Authentication:
//    1. Trocar `if true` por `if request.auth != null`
//    2. Para dados de usuário: `if request.auth.token.name == userName`
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados compartilhados (produtos, colaboradores, produção, etc.)
    match /compartilhado/{key}/dados/{document} {
      allow read:  if true;
      allow write: if true;  // TODO: `if request.auth != null`
    }

    // Dados pessoais de cada usuário
    match /usuarios/{userName}/dados/{key} {
      allow read, write: if true;  // TODO: `if request.auth.token.name == userName`
    }

    // Bloqueia qualquer outro caminho (proteção de fallback)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// ─────────────────────────────────────────────────────────────
//  Firestore Security Rules — Hub Interno Pratik
//  Protegido por Firebase Authentication.
//  Apenas usuários autenticados (Google ou Email/Senha) têm acesso.
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados compartilhados — apenas usuários autenticados
    match /compartilhado/{key}/dados/{document} {
      allow read, write: if request.auth != null;
    }

    // Dados pessoais de cada usuário — apenas autenticados
    match /usuarios/{userName}/dados/{key} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia qualquer outro caminho
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dados compartilhados entre todos — exige Firebase auth (anônima já basta)
    match /compartilhado/{key}/dados/{document} {
      allow read, write: if request.auth != null;
    }

    // Dados pessoais por usuário — apenas o próprio usuário Firebase acessa
    match /usuarios/{userName}/dados/{key} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia qualquer outro caminho
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

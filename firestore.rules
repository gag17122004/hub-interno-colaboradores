rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /compartilhado/{key}/dados/{document} {
      allow read, write: if true;
    }

    match /usuarios/{userName}/dados/{key} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção compartilhada
    // Todos podem ler e escrever (já que a autenticação é gerenciada no frontend)
    match /compartilhado/{document=**} {
      allow read, write: if true;
    }
    
    // Regras para a coleção de usuários
    // Todos podem ler e escrever nos seus próprios dados e nos de outros
    // (A restrição de acesso é feita no frontend pelo perfil master/colab)
    match /usuarios/{userName}/{document=**} {
      allow read, write: if true;
    }
    
    // NOTA DE SEGURANÇA:
    // Como o app usa autenticação customizada no localStorage (sem Firebase Auth),
    // as regras do Firestore precisam ser abertas (if true).
    // Para um ambiente de produção real, recomenda-se migrar para o Firebase Auth
    // e usar regras baseadas no request.auth.uid.
  }
}
